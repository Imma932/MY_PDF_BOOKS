      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Spring Boot provides a variety of features that address todayâ€™s business needs with a powerful database and state of the art MVC framework. This practical guide will help you get up and running with all the latest features of Spring Boot.</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Learning Spring Boot 2.0 - Second Edition</rdf:li>
        </rdf:Alt>
      </dc:title>
